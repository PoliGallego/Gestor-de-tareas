
limit_req_zone $binary_remote_addr zone=limit_por_ip:10m rate=10r/s;

server {
    listen 80;
    server_name gestortareas.* localhost;

    client_max_body_size 20M;

    limit_req zone=limit_por_ip burst=20 nodelay;

    location / {
        root /var/www/home/dist/;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /log-in/ {
        alias /var/www/login/dist/;
        index index.html;
        try_files $uri $uri /log-in/index.html;
    }

    location /sign-up/ {
        alias /var/www/signup/dist/;
        index index.html;
        try_files $uri $uri/ /sign-up/index.html;
    }

    location /board/ {
        alias /var/www/principal/dist/;
        index index.html;
        try_files $uri $uri/ /board/index.html;
    }

    location /prof/ {
        alias /var/www/profile/dist/;
        index index.html;
        try_files $uri $uri/ /prof/index.html;
    }

    location /rep/ {
        alias /var/www/reports/dist/;
        index index.html;
        try_files $uri $uri/ /rep/index.html;
    }

    location ~ ^/(login|signup|auth|logout|edit)($|/) {
	proxy_pass http://127.0.0.1:8090;
	
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
       
	proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    
    location ~ ^/api/(tableros|paneles) {
	proxy_pass http://127.0.0.1:8081;
	
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
       
	proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/dash {
	proxy_pass http://127.0.0.1:8082;
	
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
       
	proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/reportes {
	proxy_pass http://127.0.0.1:8083;
	
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
       
	proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
