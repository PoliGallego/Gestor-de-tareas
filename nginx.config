
limit_req_zone $binary_remote_addr zone=limit_por_ip:10m rate=10r/s;

server {
    listen 80;
    server_name misitio.com;

    client_max_body_size 20M;

    limit_req zone=limit_por_ip burst=20 nodelay;

    location / {
        root (direccion del home)/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /log-in {
        # 'alias' se usa en lugar de 'root' para subrutas
        alias (direccion del login)/dist/;
        index index.html;

        try_files $uri $uri/ /admin/index.html;
    }

    location /sign-up {
        alias (direccion del signup)/dist/;
        index index.html;
        try_files $uri $uri/ /dashboard/index.html;
    }

    location /board {
        alias (direccion del principal)/dist/;
        index index.html;
        try_files $uri $uri/ /dashboard/index.html;
    }

    location /prof {
        alias (direccion del perfil)/dist/;
        index index.html;
        try_files $uri $uri/ /dashboard/index.html;
    }

    location /rep {
        alias (direccion de los reportes)/dist/;
        index index.html;
        try_files $uri $uri/ /dashboard/index.html;
    }
}